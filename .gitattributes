# Normalise line endings. The repository stores LF; Windows checkouts keep LF too,
# which Python, Ruff and VS Code all handle natively and which stops Git from
# rewriting every file on checkout.
* text=auto eol=lf

# Shell scripts that genuinely need platform endings
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# Generated — keep it out of diffs and language statistics
uv.lock linguist-generated=true -diff

# Binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.xlsx  binary
