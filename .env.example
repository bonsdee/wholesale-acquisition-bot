# Copy to .env and fill in. All settings are prefixed ACQBOT_.

# --- Database (Supabase: Project Settings → Database → Connection string → URI, "Session" pooler or direct) ---
# Use the postgresql+pg8000:// scheme (postgresql+psycopg:// is accepted and rewritten). Supabase needs sslmode=require.
ACQBOT_DATABASE_URL=postgresql+pg8000://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# --- Inbound lead webhook (shared with the upstream sourcing platform) ---
ACQBOT_LEAD_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Allow unsigned POST /leads (local dev with the simulator only). Never true in production.
ACQBOT_ALLOW_UNSIGNED_LEADS=false

# --- Dealership identity (placeholders until confirmed) ---
ACQBOT_DEALERSHIP_NAME=Placeholder Motors
ACQBOT_DEALERSHIP_LMCT=00000
ACQBOT_AGENT_NAMES=["Alex"]

# --- Enrichment providers: stub | (real provider names arrive with the API keys) ---
ACQBOT_VIN_PROVIDER=stub
ACQBOT_PPSR_PROVIDER=stub
ACQBOT_REGO_PROVIDER=stub
ACQBOT_GUIDE_PROVIDER=stub
ACQBOT_COMPS_PROVIDER=stub

# --- Business parameters (spec defaults; margin and transport are placeholders until supplied) ---
ACQBOT_DEDUPE_WINDOW_DAYS=90
ACQBOT_HIGH_VALUE_THRESHOLD_AUD=60000
ACQBOT_TARGET_MARGIN_PCT=0.10
# Optional per-segment override as JSON: small | medium | large | suv | ute | prestige
ACQBOT_TARGET_MARGIN_BY_SEGMENT={}
ACQBOT_TRANSPORT_COST_AUD=250
ACQBOT_LADDER_OPENING=0.88
ACQBOT_LADDER_STEP_1=0.93
ACQBOT_LADDER_STEP_2=0.97
ACQBOT_OFFER_EXPIRY_HOURS=48

# --- Behaviour flags ---
# false = human presents every offer (Phase 3/4 mode). true = Phase 5 automated presentation.
ACQBOT_AUTO_PRESENT_OFFER=false
ACQBOT_MIN_PHOTOS=6
ACQBOT_HUMAN_SLA_HOURS=4
ACQBOT_NO_PROGRESS_TURNS=3
ACQBOT_TIMEZONE=Australia/Melbourne

# --- Messenger Platform (fill in once the Meta app + Page exist) ---
ACQBOT_MESSENGER_PAGE_ACCESS_TOKEN=
ACQBOT_MESSENGER_APP_SECRET=
ACQBOT_MESSENGER_VERIFY_TOKEN=pick-a-random-string
ACQBOT_MESSENGER_PAGE_USERNAME=yourpage

# --- SMS (Twilio-shaped; fill in once an AU number exists) ---
ACQBOT_TWILIO_ACCOUNT_SID=
ACQBOT_TWILIO_AUTH_TOKEN=
ACQBOT_TWILIO_FROM_NUMBER=

# --- Language model (Phase 4 — discovery only) ---
# auto = use Claude when the API key below is set, otherwise scripted templates.
# anthropic | fake (deterministic, no network — demos and tests) | off
ACQBOT_LLM_PROVIDER=auto
# console.anthropic.com → API keys. Never commit this file with a real key in it.
ACQBOT_ANTHROPIC_API_KEY=
ACQBOT_EXTRACTION_MODEL=claude-haiku-4-5-20251001
ACQBOT_CONVERSATION_MODEL=claude-sonnet-5
# low | medium | high (or empty for the API default). Short replies want speed.
ACQBOT_LLM_EFFORT=low
ACQBOT_LLM_TIMEOUT_SECONDS=30
# Rewrite attempts after the gate rejects a draft, before the scripted wording goes out instead.
ACQBOT_LLM_GATE_RETRIES=1
# Section 7.3: last N turns verbatim; older turns folded into a rolling summary.
ACQBOT_HISTORY_VERBATIM_TURNS=15
# Model-extracted facts below this confidence are not recorded; the question is asked again.
ACQBOT_FACT_MIN_CONFIDENCE=0.7

# --- Minimal human console: X-Admin-Token header on /admin/* (empty disables the endpoints) ---
ACQBOT_ADMIN_TOKEN=

# --- Worker ---
ACQBOT_WORKER_POLL_SECONDS=1.0
